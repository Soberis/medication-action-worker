# Core API Service Configuration
PLATFORM_API_URL=http://localhost:8080
# 二选一；生产环境建议使用权限受限文件，worker 会在每次请求读取以支持轮换
PLATFORM_WORKER_BEARER_TOKEN=
PLATFORM_WORKER_BEARER_TOKEN_FILE=

# RabbitMQ Message Broker Configuration
# 注意本项目 broker 的实际部署形态：RabbitMQ 跑在 Windows 主机上，本体只监听 127.0.0.1:5672，
# 对外由 Windows portproxy 暴露成 <broker-host>:5673，且 vhost 为 /medication（端口不是默认 5672）。
# 把 <broker-host> 换成实际 IP（当前部署为 192.168.1.7）。密码请与 Core 侧保持一致，勿把真实密码提交进仓库。
RABBITMQ_URL=amqp://medication_local:<broker-password>@<broker-host>:5673/medication
RABBITMQ_QUEUE=platform.ai.action-candidate.v1

# AMQP 心跳秒数。回调内要跑 ffmpeg 切片 + 多窗口推理，期间无法 pump 事件循环，
# 必须保持 0 关闭心跳，否则默认 60s 心跳会被 broker 判定失联而断开连接。
RABBITMQ_HEARTBEAT=0
RABBITMQ_BLOCKED_TIMEOUT=300

# run.sh 启动前自检开关：设为 1 可跳过 (不推荐)
SKIP_PRECHECK=0

# Worker Instance Identification & Model Parameters
# WORKER_ID 留空即可，不要手写一个自造的名字。
# 身份是凭证的推论，不是部署配置：worker 会先取令牌的 sub（生产 JWT 模式），
# 取不到才回落到平台 local 替身的默认值 ai-worker-local-1。手写 action-worker-4090-01
# 这类名字与平台认定的身份不相等，会让 /lease 稳定返回 403
# （AI_HAND_POSE_WORKER_IDENTITY_MISMATCH）。
# 只有平台侧显式改了 platform.security.local-ai-worker-id / AI_WORKER_ID 时才需要填同一个值。
WORKER_ID=
MODEL_PATH=~/models/Qwen3.5-4B
SAMPLING_FPS=1.0

# 显存管理策略 (弹性显存引擎): IDLE_OFFLOAD_SECONDS (单位: 秒)
#   -1  : 保持原版常驻行为 (启动即占用 ~8.5GB 显存，永不卸载)
#    0  : 极严格即用即卸模式 (单个任务处理完立即彻底释放显存至 0 MB)
#  300  : 最优解推荐 (平时 0 MB 显存；首个任务 ~1.6s 唤醒；空闲 5 分钟无新任务自动归还显存；连续任务零冷启动)
IDLE_OFFLOAD_SECONDS=300

# 单窗口生成上限。密集窗口在 512 下仍可能截断，生产默认使用 1024；
# 若显式设得更低，疑似截断时 worker 会自动用 1024 重试一次。
MAX_NEW_TOKENS=1024

# Qwen3.5 Hub kernels（实验性；必须在独立环境完成兼容性和结果回归后再打开）
QWEN_USE_HUB_KERNELS=0

# httpx 是否读取 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY。worker 只访问内网 Core API，
# 走代理必然是错的，且症状是「拿到代理自己的 5xx」很难查，所以默认关闭。
# 仅当所在环境确实必须经代理才能访问 PLATFORM_API_URL 时才设为 1。
PLATFORM_TRUST_ENV=0

# PyTorch CUDA Memory Allocation Optimization
PYTORCH_ALLOC_CONF=expandable_segments:True
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
